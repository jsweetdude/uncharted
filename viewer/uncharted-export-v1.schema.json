{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uncharted:export:1",
  "title": "Uncharted map file, version 1",
  "description": "One map of a corpus: items placed by meaning, their neighborhoods, candidate connections and drafts. Rules a JSON Schema cannot express (column lengths, references, unique ids) are listed in schema/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "title", "exported", "manifest", "stats", "lookups", "items", "neighborhoods", "candidates"],
  "properties": {
    "format": {"const": "uncharted-export"},
    "version": {"const": 1},
    "id": {"$ref": "#/$defs/slug"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "exported": {"$ref": "#/$defs/timestamp"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "stats": {"$ref": "#/$defs/stats"},
    "lookups": {"$ref": "#/$defs/lookups"},
    "items": {"$ref": "#/$defs/items"},
    "neighborhoods": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/neighborhood"}},
    "candidates": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "date": {"description": "A calendar date, such as 2026-10-28.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timestamp": {
      "description": "An RFC 3339 date and time with seconds and an offset, such as 2026-10-28T21:14:03Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "dateOrTimestamp": {"anyOf": [{"$ref": "#/$defs/date"}, {"$ref": "#/$defs/timestamp"}]},
    "httpUrl": {"description": "Printable ASCII without spaces; other characters are percent-encoded.", "type": "string", "maxLength": 2000, "pattern": "^https?://[!-~]+$"},
    "unit": {"description": "A flat-map coordinate; see Coordinates in schema/README.md.", "type": "number", "minimum": 0, "maximum": 1},
    "sim": {"description": "Cosine similarity between two embeddings.", "type": "number", "minimum": -1, "maximum": 1},
    "pct": {"type": "number", "minimum": 0, "maximum": 100},
    "itemRef": {"description": "An item's position in the items columns, from 0.", "type": "integer", "minimum": 0},
    "itemSim": {
      "description": "[item position, cosine similarity to that item]",
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/itemRef"}, {"$ref": "#/$defs/sim"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "scalar": {"anyOf": [{"type": "string", "maxLength": 1000}, {"type": ["number", "boolean", "null"]}]},
    "params": {
      "description": "Named settings, each a string, number, boolean or null.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "manifest": {
      "description": "How the map was made: enough to tell whether two maps can be compared and to make this one again.",
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "corpus", "embedding"],
      "properties": {
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 60},
            "version": {"type": "string", "minLength": 1, "maxLength": 40},
            "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
          }
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sources"],
          "properties": {
            "kind": {"description": "What one item is: talk, paper, patent.", "type": "string", "minLength": 1, "maxLength": 40},
            "topic": {"description": "The field as the person who made the map named it.", "type": "string", "maxLength": 300},
            "sources": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/source"}},
            "cleaning": {"description": "Rules applied before embedding, one sentence each.", "type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
            "popularity": {"description": "What the popularity numbers count, such as citations.", "type": "string", "minLength": 1, "maxLength": 200},
            "tags": {"description": "What the tags are, such as OpenAlex topics and keywords.", "type": "string", "minLength": 1, "maxLength": 200},
            "fingerprint": {"description": "A hash of the embedding configuration and every item's id and embedded text, in row order: equal fingerprints mean the same corpus embedded the same way.", "type": "string", "pattern": "^[0-9a-f]{32}$"}
          }
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "dimensions"],
          "properties": {
            "provider": {"enum": ["local", "openai", "voyage"]},
            "model": {"type": "string", "minLength": 1, "maxLength": 200},
            "revision": {"description": "The model's exact version, such as a Hugging Face commit.", "type": "string", "minLength": 1, "maxLength": 100},
            "dimensions": {"type": "integer", "minimum": 1, "maximum": 16384},
            "maxTokens": {"description": "Text past this many tokens was cut before embedding.", "type": "integer", "minimum": 1, "maximum": 1000000},
            "pooling": {"type": "string", "minLength": 1, "maxLength": 40},
            "normalized": {"type": "boolean"},
            "instruction": {"description": "Text prefixed to every item before embedding; null for none.", "type": ["string", "null"], "maxLength": 2000},
            "precision": {"type": "string", "minLength": 1, "maxLength": 20},
            "input": {"description": "Which fields of an item were embedded.", "type": "string", "minLength": 1, "maxLength": 300},
            "truncated": {"description": "How many items were longer than maxTokens.", "type": "integer", "minimum": 0}
          }
        },
        "map": {"$ref": "#/$defs/params"},
        "candidates": {"$ref": "#/$defs/params"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "url": {"$ref": "#/$defs/httpUrl"},
        "query": {"description": "Exactly what was asked of the source: a filter, a search, a list of pages.", "type": "string", "maxLength": 2000},
        "retrieved": {"$ref": "#/$defs/dateOrTimestamp"},
        "items": {"type": "integer", "minimum": 0},
        "license": {"type": "string", "maxLength": 200},
        "attribution": {"type": "string", "maxLength": 500}
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "neighborhoods", "unclustered", "candidates", "drafts", "nn1Percentiles"],
      "properties": {
        "items": {"type": "integer", "minimum": 2},
        "neighborhoods": {"type": "integer", "minimum": 0},
        "unclustered": {"type": "integer", "minimum": 0},
        "candidates": {"type": "integer", "minimum": 0},
        "drafts": {"type": "integer", "minimum": 0},
        "nn1Percentiles": {
          "description": "Percentiles of items.nn1 across the corpus, computed before rounding.",
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "5", "10", "25", "50", "75", "90", "95", "99"],
          "properties": {
            "1": {"$ref": "#/$defs/sim"},
            "5": {"$ref": "#/$defs/sim"},
            "10": {"$ref": "#/$defs/sim"},
            "25": {"$ref": "#/$defs/sim"},
            "50": {"$ref": "#/$defs/sim"},
            "75": {"$ref": "#/$defs/sim"},
            "90": {"$ref": "#/$defs/sim"},
            "95": {"$ref": "#/$defs/sim"},
            "99": {"$ref": "#/$defs/sim"}
          }
        }
      }
    },
    "lookups": {
      "description": "Tables the items columns point into by position.",
      "type": "object",
      "additionalProperties": false,
      "required": ["venues", "urlPrefixes"],
      "properties": {
        "venues": {"type": "array", "maxItems": 100000, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "urlPrefixes": {"type": "array", "maxItems": 10000, "items": {"type": "string", "maxLength": 500, "pattern": "^https?://[!-~]*$"}}
      }
    },
    "items": {
      "description": "One column per field; row i of every column is item i.",
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "id", "title", "x", "y", "cluster", "nn1", "lonely"],
      "properties": {
        "count": {"type": "integer", "minimum": 2, "maximum": 500000},
        "id": {"type": "array", "maxItems": 500000, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "title": {"type": "array", "maxItems": 500000, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "x": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/unit"}},
        "y": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/unit"}},
        "cluster": {"description": "Neighborhood id, or -1 for an item in no neighborhood.", "type": "array", "maxItems": 500000, "items": {"type": "integer", "minimum": -1}},
        "nn1": {"description": "Similarity to the item's nearest neighbor in the full embedding space.", "type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/sim"}},
        "lonely": {"description": "Share of the corpus whose nearest neighbor is closer than this item's, 0 to 100.", "type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/pct"}},
        "year": {"type": "array", "maxItems": 500000, "items": {"type": ["integer", "null"], "minimum": 1000, "maximum": 2999}},
        "venue": {"description": "Position in lookups.venues, or -1.", "type": "array", "maxItems": 500000, "items": {"type": "integer", "minimum": -1}},
        "urlPrefix": {"description": "Position in lookups.urlPrefixes, or -1 for an item with no link.", "type": "array", "maxItems": 500000, "items": {"type": "integer", "minimum": -1}},
        "url": {"description": "The rest of the link after its prefix; empty when urlPrefix is -1.", "type": "array", "maxItems": 500000, "items": {"type": "string", "maxLength": 2000, "pattern": "^[!-~]*$"}},
        "snippet": {"description": "The first words of the item's embedded text.", "type": "array", "maxItems": 500000, "items": {"type": "string", "maxLength": 400}},
        "source": {"description": "Position in manifest.corpus.sources, or -1.", "type": "array", "maxItems": 500000, "items": {"type": "integer", "minimum": -1}}
      }
    },
    "neighborhood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terms", "tags", "size", "x", "y", "density", "examples"],
      "properties": {
        "id": {"description": "Equal to the neighborhood's position in the list.", "type": "integer", "minimum": 0},
        "terms": {"description": "Words distinctive of the neighborhood's titles, most distinctive first.", "type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "tags": {"description": "Source tags distinctive of the neighborhood, most distinctive first.", "type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "size": {"type": "integer", "minimum": 1},
        "x": {"$ref": "#/$defs/unit"},
        "y": {"$ref": "#/$defs/unit"},
        "density": {"description": "Median nn1 of the neighborhood's items: higher is more crowded.", "$ref": "#/$defs/sim"},
        "popularity": {"description": "Sum of the items' popularity signal (citations, for papers).", "type": "number", "minimum": 0},
        "slot": {"description": "A color index chosen so neighborhoods that touch on the map differ.", "type": "integer", "minimum": 0, "maximum": 31},
        "examples": {"description": "The items closest to the neighborhood's center.", "type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/itemRef"}}
      }
    },
    "candidate": {
      "description": "A point in the full embedding space where little or nothing has been written, and what it was built from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "kind", "label", "x", "y", "score", "neighborhoods", "parents", "nearest", "tags", "drafts"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "code": {"description": "Short display code: the kind's initial and a rank within the kind.", "type": "string", "pattern": "^[A-Z][0-9]{1,4}$"},
        "kind": {"enum": ["connection", "pair", "blend"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "headline": {"type": "string", "maxLength": 400},
        "x": {"description": "Approximate map position, or null when the candidate is not drawn on the map.", "type": ["number", "null"], "minimum": 0, "maximum": 1},
        "y": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "spread": {"description": "How widely the nearest items scatter on the map, in map units.", "type": "number", "minimum": 0, "maximum": 2},
        "score": {
          "type": "object",
          "required": ["nn1", "lonely"],
          "maxProperties": 20,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"},
          "properties": {
            "nn1": {"description": "Similarity of the candidate point to its nearest real item.", "$ref": "#/$defs/sim"},
            "lonely": {"description": "Share of real items whose nearest neighbor is closer than the candidate's.", "$ref": "#/$defs/pct"},
            "mixNn1": {"description": "Connections: similarity of the mixture, before it was pushed, to its nearest real item other than its two parents and their nearest neighbors.", "$ref": "#/$defs/sim"},
            "baseline": {"description": "Connections: median mixNn1 of random mixtures whose parents are as similar and sit in regions as dense.", "$ref": "#/$defs/sim"},
            "margin": {"description": "Connections: baseline minus mixNn1; above 0 is emptier than chance.", "type": "number", "minimum": -2, "maximum": 2},
            "beats": {"description": "Connections: share of those matched random mixtures this mixture is emptier than.", "$ref": "#/$defs/pct"},
            "pairTail": {"description": "Connections: share of the random mixtures from this pair of neighborhoods that are among the emptiest 5% of their matched group; chance gives 5.", "$ref": "#/$defs/pct"},
            "pairP": {"description": "Connections: chance of a pairTail at least this large if the pair were no emptier than others (binomial), before correcting for the number of pairs tested.", "type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": {"type": "number"}
        },
        "targetPct": {"$ref": "#/$defs/pct"},
        "stop": {"type": "string", "maxLength": 80},
        "neighborhoods": {"type": "array", "maxItems": 20, "items": {"type": "integer", "minimum": 0}},
        "parents": {"description": "Items the candidate was built from.", "type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/itemRef"}},
        "nearest": {"description": "The real items closest to the candidate point, closest first: what a draft must not copy.", "type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/itemSim"}},
        "tags": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "brief": {"description": "The writing brief, plain text with light Markdown.", "type": "string", "maxLength": 50000},
        "drafts": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/draft"}}
      }
    },
    "draft": {
      "description": "A text written for a candidate, embedded like a real item and measured.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "title", "text", "verdict", "nn1", "lonely", "reasons", "x", "y", "nearest"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "code": {"type": "string", "pattern": "^d[0-9]{1,4}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "text": {"type": "string", "minLength": 1, "maxLength": 50000},
        "notes": {"description": "Who it helps, the barrier, the standard it touches; not embedded.", "type": "string", "maxLength": 5000},
        "verdict": {"enum": ["pass", "retry"]},
        "nn1": {"$ref": "#/$defs/sim"},
        "lonely": {"$ref": "#/$defs/pct"},
        "toCandidate": {"description": "Similarity of the draft to the candidate point.", "$ref": "#/$defs/sim"},
        "reasons": {"description": "Why a draft needs another try; empty for a pass.", "type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "x": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "y": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "nearest": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/itemSim"}},
        "checked": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
